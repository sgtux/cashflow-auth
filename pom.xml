<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.cashflow</groupId>
    <artifactId>cashflow-auth</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>cashflow-auth</name>
    <description>Servico de identidade do Cashflow: autentica e emite JWT assinado com RS256 (ver ./docs)</description>

    <properties>
        <java.version>21</java.version>
        <bcrypt.version>0.10.2</bcrypt.version>
        <!-- Nao e gerenciado pelo BOM do spring-boot-starter-parent; pinar explicitamente.
             9.47 e a linha alinhada com o Spring Security 6.4 (Spring Boot 3.4). -->
        <nimbus-jose-jwt.version>9.47</nimbus-jose-jwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Leitura da tabela [User] do Cashflow (credenciais). Nao ha JPA nem Flyway aqui:
             este servico nao e dono de nenhum schema, so consulta. Ver ./docs/arquitetura.md secao 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Assinatura RS256 + construcao do documento JWKS. Versao gerenciada pelo BOM do Spring Boot. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- BCrypt "enhanced" (SHA-512 + Base64 antes do bcrypt) para bater com o
             BCrypt.Net EnhancedVerify usado no cadastro do .NET. Ver ./docs/especificacao.md secao 6. -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
