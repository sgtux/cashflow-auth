# Copie para .env (nao versionado) e ajuste. application.yml importa este arquivo automaticamente.
# Ver ./docs/especificacao.md secao 5.

# --- Banco (schema "auth": auth.AuthIdentity, criado pelo Flyway) ---
# O banco (databaseName) precisa existir: o Flyway cria o schema e as tabelas, nao o banco.
# Em producao, pode ser o MESMO banco do Cashflow .NET. Em dev, o docker-compose deste
# projeto sobe um SQL Server proprio para desenvolvimento local.
DATABASE_URL=jdbc:sqlserver://localhost:1435;databaseName=cashflow;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=sa
DATABASE_PASSWORD=Auth@Local123

# --- Emissao de token ---
# Vai na claim "iss"; os consumidores validam este valor exato.
AUTH_ISSUER=http://localhost:9000
AUTH_TOKEN_TTL_MINUTES=60

# "kid" da chave ativa. Precisa casar com o kid dentro do JWKS. Recomendado: data da geracao da
# chave (yyyy-MM) - troque a cada rotacao (ver docs/especificacao.md secao 5.2), nao deixe fixo.
AUTH_ACTIVE_KID=2026-09

# Chave privada RSA ativa (PEM PKCS#8, "-----BEGIN PRIVATE KEY-----"). Deixe vazio em dev para
# usar a chave efemera gerada na subida. Em producao vem de um secret manager.
# Gerar um par:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out local/keys/active.pem
#   openssl rsa -in local/keys/active.pem -pubout -out local/keys/active.pub
# e colar o conteudo de active.pem aqui (ou usar: AUTH_PRIVATE_KEY_PEM="$(cat local/keys/active.pem)").
AUTH_PRIVATE_KEY_PEM=

# JWKS extra (JSON) com chaves PUBLICAS antigas ainda aceitas durante uma rotacao de chave.
# Ex.: {"keys":[{"kty":"RSA","kid":"2026-01",...}]}
AUTH_ADDITIONAL_JWKS=

# Dev: gera par RSA efemero quando AUTH_PRIVATE_KEY_PEM esta vazio. DEVE ser false em producao.
AUTH_DEV_GENERATE_KEY=true

# Porta HTTP.
SERVER_PORT=9000

# --- Login social (POST /api/token/oauth) ---
# Client ID do app no Google Cloud Console (valida a claim "aud" do ID token do Google).
AUTH_OAUTH_GOOGLE_CLIENT_ID=123.apps.googleusercontent.com

# Client ID (Application ID) e Tenant ID do app no Microsoft Entra ID.
AUTH_OAUTH_MICROSOFT_CLIENT_ID=123-example-123
AUTH_OAUTH_MICROSOFT_TENANT_ID=123-example-123

# --- Telemetria (OpenTelemetry -> Dynatrace) ---
# Ponte lida em application.yml (bloco "otel:") - .env sozinho nao chega no SDK do
# OpenTelemetry, precisa dessa ponte via propriedades Spring "otel.*". Ver conversa/commit.
# OTEL_SDK_DISABLED=true desliga o SDK inteiro (sem nenhuma tentativa de rede) - util pra
# isolar problema de subida sem depender do Dynatrace.
# OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://{seu-tenant}.live.dynatrace.com/api/v2/otlp
# Sem aspas - .env e parseado como .properties, aspas viram parte literal do valor.
# O token (prefixo dt0c01.) precisa ser um Access Token do Dynatrace com os escopos:
# openTelemetryTrace.ingest, logs.ingest, metrics.ingest (Settings > Access Tokens).
# ESQUEMA "Api-Token", NAO "Bearer" - token classico dt0c01.* do Dynatrace usa esse esquema
# proprio; "Bearer" e so para Platform Token (OAuth). "Bearer" com token dt0c01.* da
# 401 "Access token is invalid" mesmo com os escopos certos - foi o que aconteceu aqui.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token {seu-token-com-escopo-de-ingest}
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_RESOURCE_ATTRIBUTES=service.name=cashflow-auth,service.version=0.1.0
OTEL_EXPORTER_OTLP_TIMEOUT=5000