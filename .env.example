# Copie para .env (nao versionado) e ajuste. application.yml importa este arquivo automaticamente.
# Ver ./docs/especificacao.md secao 5.

# --- Banco de usuarios (a tabela [User] do Cashflow) ---
# Em producao, aponta para o MESMO banco do Cashflow .NET. Em dev, o docker-compose deste
# projeto sobe um SQL Server proprio ja com um usuario de teste (ver local/seed.sql).
DATABASE_URL=jdbc:sqlserver://localhost:1435;databaseName=cashflow;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=sa
DATABASE_PASSWORD=Auth@Local123

# --- Emissao de token ---
# Vai na claim "iss"; os consumidores validam este valor exato.
AUTH_ISSUER=http://localhost:9000
AUTH_TOKEN_TTL_MINUTES=60

# "kid" da chave ativa. Precisa casar com o kid dentro do JWKS.
AUTH_ACTIVE_KID=dev

# Chave privada RSA ativa (PEM PKCS#8, "-----BEGIN PRIVATE KEY-----"). Deixe vazio em dev para
# usar a chave efemera gerada na subida. Em producao vem de um secret manager.
# Gerar um par:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out local/keys/active.pem
#   openssl rsa -in local/keys/active.pem -pubout -out local/keys/active.pub
# e colar o conteudo de active.pem aqui (ou usar: AUTH_PRIVATE_KEY_PEM="$(cat local/keys/active.pem)").
AUTH_PRIVATE_KEY_PEM=

# JWKS extra (JSON) com chaves PUBLICAS antigas ainda aceitas durante uma rotacao de chave.
# Ex.: {"keys":[{"kty":"RSA","kid":"2026-01",...}]}
AUTH_ADDITIONAL_JWKS=

# Dev: gera par RSA efemero quando AUTH_PRIVATE_KEY_PEM esta vazio. DEVE ser false em producao.
AUTH_DEV_GENERATE_KEY=true

# Porta HTTP.
SERVER_PORT=9000
